# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Bot username without "@" (used for deep links)
BOT_USERNAME=dtek_tracker_bot

# Public URL of the Telegram Mini App (GitHub Pages, docs/)
WEBAPP_URL=https://yaneia.github.io/telegram_bot_dtek

# SQLite database path
DATABASE_PATH=data/bot.db

# Polling intervals (seconds)
SCRAPE_INTERVAL_SECONDS=600
NOTIFICATION_CHECK_INTERVAL_SECONDS=60

# Use only deterministic mock fixtures (offline demo mode)
MOCK_FALLBACK_ONLY=false

# Default render mode: image | text
DEFAULT_RENDER_MODE=image

LOG_LEVEL=INFO

# GitHub Actions workflow_dispatch trigger (replaces GitHub cron schedule)
GITHUB_TOKEN=
GITHUB_REPO=Yaneia/telegram_bot_dtek
GITHUB_SCRAPE_WORKFLOW=scrape.yml
GITHUB_SCRAPE_REF=main
GITHUB_SCRAPE_INTERVAL_SECONDS=900
